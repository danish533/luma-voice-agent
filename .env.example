# Copy to .env and fill in. Never commit the filled copy.

# --- Transport: LiveKit Cloud (free tier is enough for a demo) -------------
# From https://cloud.livekit.io -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech: Deepgram (streaming STT + streaming TTS from one key) ---------
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-odysseus-en
# Must match the voice's gender -- Odysseus is masculine.
AGENT_NAME=Theo

# Semantic end-of-turn detection.
#   local -> runs in the worker. No network hop on the latency-critical path,
#            and `make console` works without LiveKit credentials.
#   cloud -> LiveKit's hosted model. Frees worker CPU; better above ~100 calls.
TURN_DETECTOR=local

# --- Reasoning and tool calling -------------------------------------------
# LLM_PROVIDER=openai  -> needs OPENAI_API_KEY
# LLM_PROVIDER=google  -> needs GOOGLE_API_KEY (Gemini free tier)
#
# Pick for latency, not for raw intelligence: the reasoning job is small.
# Measured time-to-first-token (see EVALUATION.md):
#   gemini-3.1-flash-lite   ~723 ms   <- what the results were produced on
#   gpt-4.1-mini            comparable
#   gemini-3.6-flash        6-12 s    <- extended thinking, unusable for voice
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.3

# Hot standby. If the primary times out or rate-limits mid-call the turn is
# retried on this one, so the caller hears a pause instead of dead air.
# Leave the model blank to disable. Needs the other provider's key set.
LLM_FALLBACK_PROVIDER=google
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Reservation API ------------------------------------------------------
RESERVATION_API_URL=http://localhost:8000
RESERVATION_API_TIMEOUT_S=5
RESERVATION_API_MAX_RETRIES=1
RESERVATION_API_RETRY_CAP_MS=1000

# --- Logging --------------------------------------------------------------
LUMA_LOG_DIR=logs
LUMA_LOG_LEVEL=INFO

# --- Production layer (both optional) --------------------------------------
# Unset either and the agent behaves exactly as it does without it: every
# store call is a no-op, every cache read a miss. `docker compose up -d`
# starts both locally.
#
# Persists the conversation -- calls, turns, tool calls, handoffs. Reservations
# stay behind the reservation API; this only references them by id.
# DATABASE_URL=postgresql+asyncpg://luma:luma@127.0.0.1:5432/luma
#
# Shared idempotency (survives a restart, and covers a redial that lands on a
# different worker) plus a 90s availability cache used only for listing.
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Ops console sign-in ---------------------------------------------------
# The console shows customer names, dates, party sizes and partial phone
# numbers, and can mint a LiveKit room token, so it is never served unguarded.
# Leave OPS_PASSWORD unset and one is generated per run and printed at startup.
# OPS_USERNAME=ops
# OPS_PASSWORD=change-me
# OPS_PASSWORD_HASH=      # preferred in production: the plaintext then never
#                         # exists in the environment or a process listing
# OPS_SECRET_KEY=         # set this, or every session is dropped on restart
