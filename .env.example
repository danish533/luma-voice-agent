# Copy to .env and fill in. Never commit the filled copy.

# --- Transport: LiveKit Cloud (free tier is enough for a demo) -------------
# From https://cloud.livekit.io -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech: Deepgram (streaming STT + streaming TTS from one key) ---------
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-odysseus-en
# Must match the voice's gender -- Odysseus is masculine.
AGENT_NAME=Theo

# Semantic end-of-turn detection.
#   local -> runs in the worker. No network hop on the latency-critical path,
#            and `make console` works without LiveKit credentials.
#   cloud -> LiveKit's hosted model. Frees worker CPU; better above ~100 calls.
TURN_DETECTOR=local

# --- Reasoning and tool calling -------------------------------------------
# LLM_PROVIDER=openai  -> needs OPENAI_API_KEY
# LLM_PROVIDER=google  -> needs GOOGLE_API_KEY (Gemini free tier)
#
# Pick for latency, not for raw intelligence: the reasoning job is small.
# Measured time-to-first-token (see EVALUATION.md):
#   gemini-3.1-flash-lite   ~723 ms   <- what the results were produced on
#   gpt-4.1-mini            comparable
#   gemini-3.6-flash        6-12 s    <- extended thinking, unusable for voice
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.3

OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Reservation API ------------------------------------------------------
RESERVATION_API_URL=http://localhost:8000
RESERVATION_API_TIMEOUT_S=5
RESERVATION_API_MAX_RETRIES=1
RESERVATION_API_RETRY_CAP_MS=1000

# --- Logging --------------------------------------------------------------
LUMA_LOG_DIR=logs
LUMA_LOG_LEVEL=INFO
